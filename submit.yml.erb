---
batch_connect:
  template: "basic"
  # Set in template/before.sh.erb and passed to view.html.erb, besides
  # host, port and password: the interface the session runs.
  conn_params:
    - text_lab_ui


script:
  # Source these scripts before and after the main script
  before_file: "template/before.sh.erb"
  after_file: "template/after.sh"

  
  
  native:
    - "--account=<%= auto_accounts %>"
    - "--job-name=dsl_textlab"
    - "--partition=<%= partition %>"
    - "--qos=<%= qos %>"
    - "--gres=<%= gpu %><%= gpu_number %>"
    - "--time=<%= time %>:00:00"
    - "--nodes=1"
    - "--mem=80g"
    - "--cpus-per-task=16"
<% unless reservation.blank? %>
    - "--reservation=<%= reservation %>"
<% end %>
<% unless wckey.blank? %>
    - "--wckey=<%= wckey %>"
<% end %>

 
