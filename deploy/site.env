# Text Lab site configuration: UBELIX, University of Bern.
#
# Everything that depends on the cluster lives here, so the launch script
# (template/script.sh.erb) and the Python code stay the same on every site.
#
# This file in the repository is the reference copy. The launch script reads
# the live copy from research storage (TEXT_LAB_SITE_ENV in the script, by
# default /storage/research/dsl_shared/solutions/ondemand/text_lab/site.env),
# in the same way the image is built from deploy/container/text_lab.def but
# run from the .sif on research storage. To change a setting, edit this file,
# test it in a sandbox app (point TEXT_LAB_SITE_ENV at it in
# template/dev.env), commit it, then copy it to research storage. No
# redeployment of the Open OnDemand app is needed.
#
# Every assignment uses ${NAME:-default}, so a value set earlier, for example
# in template/dev.env, takes precedence.
#
# Unexported variables are used only by the launch script. Exported
# variables are passed into the container and read by the app
# (textlab.common.config).

# ---------------------------------------------------------------------------
# Locations on this cluster (launch script only)
# ---------------------------------------------------------------------------

# Base folder on shared storage holding the releases, images and models.
TEXT_LAB_BASE="${TEXT_LAB_BASE:-/storage/research/dsl_shared/solutions/ondemand/text_lab}"

# The src/ folder of the release to serve; it holds the textlab package.
TEXT_LAB_SRC="${TEXT_LAB_SRC:-$TEXT_LAB_BASE/current/src}"

# Apptainer image with all dependencies, built from text_lab.def. It must
# carry the paddle_vl_backend environment (paddleocr 3.7 with paddlex[ocr])
# for the automatic OCR pipeline and the tesseract binary for the
# searchable-PDF export.
TL_CONTAINER="${TL_CONTAINER:-$TEXT_LAB_BASE/container/text_lab_210526.sif}"

# Model stores on shared storage, mounted into the image under /opt.
TEXT_LAB_MODELS="${TEXT_LAB_MODELS:-$TEXT_LAB_BASE/container/models}"
HOST_OLLAMA_DIR="${HOST_OLLAMA_DIR:-$TEXT_LAB_MODELS/ollama}"
HOST_WHISPER_DIR="${HOST_WHISPER_DIR:-$TEXT_LAB_MODELS/whisper}"
HOST_WHISPERX_DIR="${HOST_WHISPERX_DIR:-$TEXT_LAB_MODELS/whisperx}"
HOST_TORCH_DIR="${HOST_TORCH_DIR:-$TEXT_LAB_MODELS/torch}"
HOST_HF_DIR="${HOST_HF_DIR:-$TEXT_LAB_MODELS/huggingface}"
HOST_EASYOCR_DIR="${HOST_EASYOCR_DIR:-$TEXT_LAB_MODELS/easyocr}"
HOST_PADDLEOCR_DIR="${HOST_PADDLEOCR_DIR:-$TEXT_LAB_MODELS/paddleocr}"
HOST_PADDLEX_DIR="${HOST_PADDLEX_DIR:-$TEXT_LAB_MODELS/paddlex}"

# Further host paths the app must see, as an Apptainer bind list
# (comma-separated). On UBELIX, users' files, research storage and the
# models above are all under /storage.
TEXT_LAB_EXTRA_BINDS="${TEXT_LAB_EXTRA_BINDS:-/storage}"

# Host name of the Open OnDemand portal, as the browser sees it.
TEXT_LAB_OOD_HOST="${TEXT_LAB_OOD_HOST:-ondemand.hpc.unibe.ch}"

# Where the per-job workspace for temporary user files is created. Empty
# means the job's $TMPDIR, which Slurm on UBELIX creates per job
# (/scratch/local/<job id>) and deletes when the job ends. Set it to another
# folder if $TMPDIR is missing or too small on a cluster; the launch script
# still deletes the workspace when the session ends.
TEXT_LAB_WORKDIR_BASE="${TEXT_LAB_WORKDIR_BASE:-}"

# Share of GPU memory olmOCR (vLLM) may use.
OLMOCR_GPU_MEMORY_UTILIZATION="${OLMOCR_GPU_MEMORY_UTILIZATION:-0.6}"

# ---------------------------------------------------------------------------
# App settings (exported into the container)
# ---------------------------------------------------------------------------

# File holding the Hugging Face token for speaker diarization. Without it,
# transcription works but speakers are not identified.
export TEXT_LAB_HF_TOKEN_FILE="${TEXT_LAB_HF_TOKEN_FILE:-/storage/research/dsl_shared/solutions/whisperx/cache/whisperx/cache/hf/hf_token.txt}"

# Folder holding the Swiss German Whisper models (swhisper-large-1.1 and
# flurin-swiss-german-turbo-ct2).
export TEXT_LAB_CUSTOM_WHISPER_DIR="${TEXT_LAB_CUSTOM_WHISPER_DIR:-/storage/research/dsl_shared/solutions/whisperx/cache/whisper}"

# Grobid image used by the Knowledge Graph to parse papers.
export TEXT_LAB_GROBID_CONTAINER="${TEXT_LAB_GROBID_CONTAINER:-$TEXT_LAB_BASE/container/grobid_0.8.2.sif}"

# OpenAI-compatible GPUStack endpoint offered as a Knowledge Graph backend.
# Text sent to it leaves the job, but stays on university infrastructure.
export TEXT_LAB_GPUSTACK_URL="${TEXT_LAB_GPUSTACK_URL:-https://gpustack.unibe.ch/v1}"

# Ollama vision model for OCR enrichments, and the models approved for
# survey extraction (comma-separated). Both must exist in the Ollama store.
export TEXTLAB_VISION_MODEL="${TEXTLAB_VISION_MODEL:-qwen3-vl:30b-a3b-instruct}"
export TEXTLAB_APPROVED_SURVEY_MODELS="${TEXTLAB_APPROVED_SURVEY_MODELS:-qwen3-vl:30b-a3b-instruct}"

# Ollama model of the GLM-OCR engine (OCR, manual engine selection). It is
# downloaded into the Ollama store on first use if missing.
export TEXTLAB_GLM_OCR_MODEL="${TEXTLAB_GLM_OCR_MODEL:-glm-ocr:latest}"
