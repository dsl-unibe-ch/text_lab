<%#
  The Connect button on a Text Lab session's card.

  text_lab_ui (set in template/before.sh.erb) names the interface the
  session runs. The web UI takes the session password from the button,
  which posts it to the app's login: the password still protects the
  session, and only this card, which only the session's owner sees, holds
  it. Streamlit cannot take a posted password, so for it the card shows the
  password to copy into the app's login form. Sessions started before
  text_lab_ui existed lack it and run Streamlit.
%>
<% if defined?(text_lab_ui) && text_lab_ui.to_s == "web" %>
<form action="/node/<%= host %>/<%= port %>/login" method="post" target="_blank">
  <input type="hidden" name="password" value="<%= password %>">
  <button class="btn btn-primary" type="submit">
    <i class="fa fa-cogs"></i> Connect to Text Lab
  </button>
</form>
<% else %>
<form action="/node/<%= host %>/<%= port %>/" method="get" target="_blank">
  <p>Your session is ready. Copy the session password and connect to Text Lab</p>

  <p><strong>Your Session Password:</strong></p>

  <div class="input-group" style="max-width: 300px; margin-bottom: 20px;">
    <input type="password" class="form-control" value="<%= password %>" readonly style="background-color: #fff; cursor: text;">
    <span class="input-group-btn">
      <button class="btn btn-default" type="button" onclick="copyPassword(this, '<%= password %>')" title="Copy to clipboard">
        <i class="fa fa-clipboard"></i> Copy
      </button>
    </span>
  </div>

  <button class="btn btn-primary" type="submit">
    <i class="fa fa-cogs"></i> Connect to Text Lab
  </button>
</form>

<script>
function copyPassword(btn, passwordText) {
  // Copy text to clipboard
  if (navigator.clipboard && window.isSecureContext) {
    // logic for modern browsers
    navigator.clipboard.writeText(passwordText);
  } else {
    // Fallback for older browsers
    var tempInput = document.createElement("input");
    tempInput.value = passwordText;
    document.body.appendChild(tempInput);
    tempInput.select();
    document.execCommand("copy");
    document.body.removeChild(tempInput);
  }

  // Provide visual feedback ONLY on the button that was clicked
  var originalHtml = btn.innerHTML;
  btn.innerHTML = '<i class="fa fa-check" style="color: green;"></i> Copied!';

  // Revert button text after 2 seconds
  setTimeout(function() {
    btn.innerHTML = originalHtml;
  }, 2000);
}
</script>
<% end %>
