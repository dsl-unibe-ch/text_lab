#!/usr/bin/env bash

# --- Helper: generate a pseudo-random alphanumeric password ------------------
create_passwd() {
  local length="${1:-16}" # default to 16 if not specified
  openssl rand -base64 32 2>/dev/null | tr -dc 'A-Za-z0-9' | head -c "$length"
}

# Export the `module` shell-function in case the compute environment relies on it.
[[ $(type -t module) == "function" ]] && export -f module

port=$(find_port)

password="$(create_passwd 16)"

export SERVER_PORT="$port"
export SERVER_BASEURLPATH="/node/${host}/${port}/"
export TOKEN="$password"

# The interface this session runs: TEXT_LAB_UI from the configuration that
# script.sh loads (config.sh), "streamlit" or "web". The Connect button
# depends on it: view.html.erb receives it as text_lab_ui (conn_params in
# submit.yml.erb). The web UI takes the password from the button, Streamlit
# asks the user for it.
text_lab_ui="$(source "$(dirname "${BASH_SOURCE[0]}")/config.sh" > /dev/null 2>&1 \
  && ui="${TEXT_LAB_UI:-streamlit}" && echo "${ui,,}")"
