# Developer overrides for a sandbox Open OnDemand app.
#
# Copy this file to template/dev.env (gitignored) in your sandbox checkout.
# template/script.sh.erb sources it at job start, so the sandbox can serve
# your working tree or test a new image without editing the launch script.
# Never commit dev.env: production must use the defaults in script.sh.erb.

# The src/ directory of your working tree (it holds the textlab package).
TEXT_LAB_SRC="$HOME/ondemand/dev/text_lab/src"

# A newly built image to test before publishing it.
# TL_CONTAINER="/path/to/text_lab_DDMMYY.sif"
