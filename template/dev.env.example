# Developer overrides for a sandbox Open OnDemand app.
#
# Copy this file to template/dev.env (gitignored) in your sandbox checkout.
# template/script.sh.erb sources it at job start, before the site
# configuration, so values set here take precedence. Never commit dev.env:
# production must use the defaults.

# The src/ folder of your working tree (it holds the textlab package).
TEXT_LAB_SRC="$HOME/ondemand/dev/text_lab/src"

# Use the repository's site configuration instead of the live copy on
# research storage, to test changes to it before copying it there.
TEXT_LAB_SITE_ENV="$HOME/ondemand/dev/text_lab/deploy/site.env"

# A newly built image to test before publishing it.
# TL_CONTAINER="/path/to/text_lab_DDMMYY.sif"
