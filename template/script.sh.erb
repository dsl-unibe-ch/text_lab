#!/usr/bin/env bash
#
# Start a Text Lab session: Ollama and the Streamlit app inside the Apptainer
# image. Open OnDemand runs this script in the session's job directory.
#
# Nothing here is specific to a cluster: site values (paths, images, model
# stores, host names) come from the site configuration, deploy/site.env,
# whose live copy is read from TEXT_LAB_SITE_ENV below.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ----------------------------------------------------------------------------
# 1. Configuration
# ----------------------------------------------------------------------------

# Optional developer overrides for a sandbox app, e.g. TEXT_LAB_SRC pointing
# at a working tree or TEXT_LAB_SITE_ENV at the repository's site.env. Open
# OnDemand copies template/ into the job directory, so template/dev.env ends
# up next to this script. It is gitignored and never part of a production
# deployment; see template/dev.env.example.
if [[ -f "$SCRIPT_DIR/dev.env" ]]; then
  echo "Loading developer overrides from $SCRIPT_DIR/dev.env"
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/dev.env"
fi

# The site configuration. This default is the only site-specific value in
# the files the HPC team deploys.
TEXT_LAB_SITE_ENV="${TEXT_LAB_SITE_ENV:-/storage/research/dsl_shared/solutions/ondemand/text_lab/site.env}"
if [[ ! -f "$TEXT_LAB_SITE_ENV" ]]; then
  echo "Error: site configuration not found at $TEXT_LAB_SITE_ENV" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$TEXT_LAB_SITE_ENV"

missing=()
for name in TEXT_LAB_SRC TL_CONTAINER TEXT_LAB_OOD_HOST \
            HOST_OLLAMA_DIR HOST_WHISPER_DIR HOST_WHISPERX_DIR HOST_TORCH_DIR \
            HOST_HF_DIR HOST_EASYOCR_DIR HOST_PADDLEOCR_DIR HOST_PADDLEX_DIR; do
  [[ -n "${!name:-}" ]] || missing+=("$name")
done
if (( ${#missing[@]} )); then
  echo "Error: $TEXT_LAB_SITE_ENV does not set: ${missing[*]}" >&2
  exit 1
fi
if [[ ! -f "$TEXT_LAB_SRC/textlab/ui/streamlit/Home.py" ]]; then
  echo "Error: TEXT_LAB_SRC=$TEXT_LAB_SRC does not hold the textlab package" >&2
  exit 1
fi
if [[ ! -f "$TL_CONTAINER" ]]; then
  echo "Error: image TL_CONTAINER=$TL_CONTAINER not found" >&2
  exit 1
fi
# Resolve symbolic links (such as the "current" release) once, so a session
# keeps the version it started with when a new release is switched in.
TEXT_LAB_SRC="$(realpath "$TEXT_LAB_SRC")"
TL_CONTAINER="$(realpath "$TL_CONTAINER")"

# Mount points of the model stores inside the image. These belong to the
# image (see deploy/container/text_lab.def), not to the site.
CONT_OLLAMA_DIR="/opt/ollama"
CONT_WHISPER_DIR="/opt/whisper"
CONT_WHISPERX_DIR="/opt/whisperx"
CONT_TORCH_DIR="/opt/torch"
CONT_HF_DIR="/opt/huggingface"
CONT_EASYOCR_DIR="/opt/easyocr"
# PaddleX/PaddleOCR ignore their environment variables in some versions and
# default to ~/.paddlex and ~/.paddleocr, so the stores are mounted there.
CONT_PADDLEOCR_DIR="$HOME/.paddleocr"
CONT_PADDLEX_DIR="$HOME/.paddlex"
PADDLE_PDX_CACHE_HOME="${PADDLE_PDX_CACHE_HOME:-$HOST_PADDLEX_DIR}"

# ----------------------------------------------------------------------------
# 2. Workspace for temporary user files
# ----------------------------------------------------------------------------

# Uploads and intermediate results go into one private folder per job,
# deleted when the session ends (see textlab.common.storage). It lives in the
# job's $TMPDIR unless the site sets TEXT_LAB_WORKDIR_BASE.
workdir_base="${TEXT_LAB_WORKDIR_BASE:-${TMPDIR:-/tmp}}"
export TEXT_LAB_WORKDIR="$workdir_base/textlab-${USER}-${SLURM_JOB_ID:-$$}"
mkdir -p -m 700 "$TEXT_LAB_WORKDIR"
mkdir -p -m 700 "$TEXT_LAB_WORKDIR/tmp"

remove_workdir() {
  rm -rf "$TEXT_LAB_WORKDIR"
}
# EXIT also runs when the job is cancelled or reaches its time limit: Slurm
# sends SIGTERM first, which is turned into a normal exit here.
trap remove_workdir EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# ----------------------------------------------------------------------------
# 3. Logs
# ----------------------------------------------------------------------------

# Logs stay with the session, in the user's own job directory next to
# output.log, where the user can find them and send them with a problem
# report (see the user guide).
TEXT_LAB_LOG_DIR="${TEXT_LAB_LOG_DIR:-$SCRIPT_DIR}"
STREAMLIT_LOG="$TEXT_LAB_LOG_DIR/streamlit.log"
OLLAMA_LOG="$TEXT_LAB_LOG_DIR/ollama.log"

# ----------------------------------------------------------------------------
# 4. Runtime parameters
# ----------------------------------------------------------------------------

TEXT_LAB_PORT="${TEXT_LAB_PORT:-${SERVER_PORT:-8502}}"
SERVER_BASEURLPATH="${SERVER_BASEURLPATH:-}"

# Random ports so several sessions on one node do not collide.
export OLLAMA_PORT=$(( (RANDOM % 10000) + 10000 ))
export OLLAMA_HOST="127.0.0.1:$OLLAMA_PORT"
export GROBID_PORT=$(( (RANDOM % 1000) + 8000 ))

# Keep the host's Python environment out of the image.
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1

if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  export CUDA_VISIBLE_DEVICES=0
fi

echo "=========================================================="
echo "Starting Text Lab session for user: $USER"
echo "Slurm job ID: ${SLURM_JOB_ID:-unknown}"
echo "Site configuration: $TEXT_LAB_SITE_ENV"
echo "Source tree: $TEXT_LAB_SRC"
echo "Container: $TL_CONTAINER"
echo "Workspace: $TEXT_LAB_WORKDIR"
echo "Logs: $STREAMLIT_LOG, $OLLAMA_LOG"
echo "Ollama host: $OLLAMA_HOST"
echo "Grobid port: $GROBID_PORT"
echo "Assigned GPU(s): $CUDA_VISIBLE_DEVICES"
echo "=========================================================="

# ----------------------------------------------------------------------------
# 5. Start Ollama and the app
# ----------------------------------------------------------------------------

binds=(
  --bind "$TEXT_LAB_WORKDIR"
  --bind "$HOST_OLLAMA_DIR:$CONT_OLLAMA_DIR:rw"
  --bind "$HOST_WHISPER_DIR:$CONT_WHISPER_DIR:rw"
  --bind "$HOST_WHISPERX_DIR:$CONT_WHISPERX_DIR:rw"
  --bind "$HOST_TORCH_DIR:$CONT_TORCH_DIR:rw"
  --bind "$HOST_HF_DIR:$CONT_HF_DIR:rw"
  --bind "$HOST_EASYOCR_DIR:$CONT_EASYOCR_DIR:rw"
  --bind "$HOST_PADDLEOCR_DIR:$CONT_PADDLEOCR_DIR:rw"
  --bind "$HOST_PADDLEX_DIR:$CONT_PADDLEX_DIR:rw"
)
if [[ -n "${TEXT_LAB_EXTRA_BINDS:-}" ]]; then
  binds+=(--bind "$TEXT_LAB_EXTRA_BINDS")
fi

# Exported variables, including the app settings from the site
# configuration and the session TOKEN from before.sh, pass into the image.
apptainer exec \
  --nv \
  "${binds[@]}" \
  --env HF_HOME="$CONT_HF_DIR" \
  --env PADDLEX_HOME="$CONT_PADDLEX_DIR" \
  --env PADDLEOCR_CACHE="$CONT_PADDLEOCR_DIR" \
  --env PADDLE_PDX_CACHE_HOME="$PADDLE_PDX_CACHE_HOME" \
  --env VLLM_GPU_MEMORY_UTILIZATION="$OLMOCR_GPU_MEMORY_UTILIZATION" \
  --env OLMOCR_GPU_MEMORY_UTILIZATION="$OLMOCR_GPU_MEMORY_UTILIZATION" \
  --env OLLAMA_MODELS="$CONT_OLLAMA_DIR/models" \
  --env OLLAMA_FLASH_ATTENTION="true" \
  --env OLLAMA_HOST="$OLLAMA_HOST" \
  --env OLLAMA_TMPDIR="$TEXT_LAB_WORKDIR/tmp" \
  --env TMPDIR="$TEXT_LAB_WORKDIR/tmp" \
  --env GROBID_PORT="$GROBID_PORT" \
  --env PYTHONPATH="$TEXT_LAB_SRC" \
  "$TL_CONTAINER" \
  bash -c "ollama serve > '$OLLAMA_LOG' 2>&1 & \
           while ! curl -s http://$OLLAMA_HOST/api/tags > /dev/null; do sleep 1; done && \
           /opt/conda/envs/text_lab_main/bin/python -u -m streamlit run '$TEXT_LAB_SRC/textlab/ui/streamlit/Home.py' \
             --server.address 0.0.0.0 \
             --server.port '$TEXT_LAB_PORT' \
             --server.baseUrlPath '$SERVER_BASEURLPATH' \
             --server.headless true \
             --server.maxUploadSize 10000 \
             --browser.serverAddress '$TEXT_LAB_OOD_HOST' \
             --browser.gatherUsageStats false \
             --logger.level info \
             --client.showErrorDetails true > '$STREAMLIT_LOG' 2>&1"
